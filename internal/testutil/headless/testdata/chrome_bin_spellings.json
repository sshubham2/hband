  {"name": "a folder", "spelling": "{dir}/sub", "want": "skip"},
  {"name": "a folder, trailing dot segment", "spelling": "{dir}/sub/.", "want": "skip"},
  {"name": "a folder called Edge", "spelling": "{dir}/Edge", "want": "skip"},
  {"name": "a file that does not exist", "spelling": "{dir}/gone/chrome.exe", "want": "skip"}
