[
  {"name": "plain", "spelling": "{dir}/msedge.exe", "want": "edge"},
  {"name": "upper case", "spelling": "{dir}/MSEDGE.EXE", "want": "edge"},
  {"name": "mixed case", "spelling": "{dir}/MsEdge.Exe", "want": "edge"},
  {"name": "no extension", "spelling": "{dir}/msedge", "want": "edge"},
  {"name": "linux package name", "spelling": "{dir}/microsoft-edge", "want": "edge"},
  {"name": "quoted as pasted from a shell", "spelling": "\"{dir}/msedge.exe\"", "want": "edge"},
  {"name": "relative", "spelling": "msedge.exe", "want": "edge"},
  {"name": "relative with dot folder", "spelling": "./msedge.exe", "want": "edge"},
  {"name": "relative through a parent", "spelling": "sub/../msedge.exe", "want": "edge"},
  {"name": "dot folder before the name", "spelling": "{dir}/./msedge.exe", "want": "edge"},
  {"name": "parent folder before the name", "spelling": "{dir}/sub/../msedge.exe", "want": "edge"},
  {"name": "file that does not exist", "spelling": "{dir}/gone/msedge.exe", "want": "edge"},

  {"name": "one trailing dot segment", "spelling": "{dir}/msedge.exe/.", "want": "edge", "windows_only": true, "why": "Windows resolves name\\. to name by its text, so os.Stat finds the file and exec starts it"},
  {"name": "one trailing dot segment, backslash", "spelling": "{dir}\\msedge.exe\\.", "want": "edge", "windows_only": true},
  {"name": "two trailing dot segments", "spelling": "{dir}/msedge.exe/./.", "want": "edge", "windows_only": true},
  {"name": "two trailing dot segments, backslash", "spelling": "{dir}\\msedge.exe\\.\\.", "want": "edge", "windows_only": true},
  {"name": "down and back up", "spelling": "{dir}/msedge.exe/x/..", "want": "edge", "windows_only": true},
  {"name": "down and back up, backslash", "spelling": "{dir}\\msedge.exe\\x\\..", "want": "edge", "windows_only": true},
  {"name": "space before the separator", "spelling": "{dir}\\msedge.exe \\.", "want": "edge", "windows_only": true, "why": "Windows drops the trailing space of an element"},
  {"name": "trailing dot in the name", "spelling": "{dir}/msedge.exe.", "want": "edge", "windows_only": true, "why": "Windows drops the trailing dot of the last element"},
  {"name": "trailing space in the name", "spelling": "{dir}/msedge.exe ", "want": "edge", "windows_only": true, "why": "Windows drops the trailing space of the last element"},
  {"name": "relative with a trailing dot segment", "spelling": "msedge.exe/.", "want": "edge", "windows_only": true},
  {"name": "upper case with a trailing dot segment", "spelling": "{dir}/MSEDGE.EXE/.", "want": "edge", "windows_only": true},
  {"name": "a file that does not exist, trailing dot segment", "spelling": "{dir}/gone/msedge.exe/.", "want": "edge", "windows_only": true},

  {"name": "chrome, plain", "spelling": "{dir}/chrome.exe", "want": "chrome"},
  {"name": "chrome, relative", "spelling": "chrome.exe", "want": "chrome"},
  {"name": "chrome, relative with dot folder", "spelling": "./chrome.exe", "want": "chrome"},
  {"name": "chrome, relative through a parent", "spelling": "sub/../chrome.exe", "want": "chrome"},
  {"name": "chrome, dot folder before the name", "spelling": "{dir}/./chrome.exe", "want": "chrome"},
  {"name": "chrome, parent folder before the name", "spelling": "{dir}/sub/../chrome.exe", "want": "chrome"},
  {"name": "chrome inside folders called Edge", "spelling": "{dir}/Edge/Application/chrome.exe", "want": "chrome"},
  {"name": "chrome, one trailing dot segment", "spelling": "{dir}/chrome.exe/.", "want": "chrome", "windows_only": true, "why": "the same text rule must not refuse a Chrome"},
